{
  "name": "@repo/router",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsc",
    "build": "tsc --build",
    "lint": "ultracite lint",
    "format": "ultracite format",
    "format:unsafe": "ultracite format --unsafe",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules dist .turbo .cache",
    "test": "dotenv -e .env -- vitest run"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "catalog:",
    "trpc-to-openapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
